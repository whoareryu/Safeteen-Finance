# --- Vercel 단독 테스트 (백엔드 없음) ---
# NEXT_PUBLIC_BACKEND_URL 을 비우면 /api/gourmet/home-browse·daily-pick 은 목 데이터,
# /api/weather·/api/gourmet/chat 은 Vercel 서버에서 직접 처리합니다.
# GEMINI_API_KEY=...
# OPENWEATHER_API_KEY=...
# OPENWEATHER_CITY=Seoul
# STANDALONE_API=true   # NEXT_PUBLIC_BACKEND_URL 이 있어도 프론트 API만 쓰려면 설정

# --- 전체 스택 (Neon DB·실제 맛집 데이터) ---
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_BACKEND_URL=https://your-api.example.com

# --- 카카오맵 ---
# JavaScript 키 (지도 SDK, 브라우저 노출). Kakao Developers → 앱 → JavaScript 키
# 사용 도메인을 카카오 콘솔 플랫폼 > Web 에 등록해야 지도가 뜸 (예: http://localhost:3000)
# NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_javascript_key
# (REST API 키는 백엔드 fastapi/.env 의 KAKAO_REST_API_KEY 에 별도 설정)
