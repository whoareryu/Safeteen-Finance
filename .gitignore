# ML 모델 아티팩트
*.pt
*.onnx
*.gguf
fastapi/runs/
# 실제 Ollama 모델 데이터(~/.ollama 또는 원격의 /usr/share/ollama/.ollama)를 가리키는
# 심볼릭 링크 — 탐색기에서 보기 편하라고 만든 바로가기라 git 추적 대상 아님
ollama-models

# QLoRA 학습 환경 (training/) — 코드만 커밋, venv·데이터·결과물은 제외
training/.venv/
training/outputs/
training/data/
**/__pycache__/
training/.pip-tmp/

# 베이스 모델 원본(수 GB) — repo 루트, ollama-models와 같은 급의 폴더. git 추적 대상 아님
models/

# a2a-mcp — 패키지별 독립 uv venv, 코드만 커밋
a2a-mcp/**/.venv/

.mcp.json
