# .importlinter
# 목적: Python import 정적 분석으로 헥사고날 레이어 순서를 강제한다.
# 사용법: pip install import-linter && lint-imports
# 공식 문서: https://import-linter.readthedocs.io/
#
# 예전엔 ontology(허브) + admin/titanic(스포크) 스타 토폴로지를 강제했지만,
# 그 앱들이 모두 제거되면서 지금은 safeteen 하나만 남은 단일 앱 구조다.
# 스포크 독립성/허브 보호 계약은 더 이상 의미가 없어 제거했다.

[importlinter]
root_packages =
    safeteen
    auth
    core

# ── Contract: 헥사고날 레이어 순서 ────────────────────────────────────────
# adapter(인프라)는 app(유스케이스)을 알 수 있지만, 역방향은 금지.
[importlinter:contract:hexagonal-layers-safeteen]
name = SafeTeen hexagonal layers
type = layers
layers =
    safeteen.adapter
    safeteen.app
    safeteen.domain
