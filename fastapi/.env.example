# OpenWeatherMap — https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_CITY=Seoul

# ── DB 컨테이너 ────────────────────────────────────────────────────

# pgvector (Docker: whoareryu-pgvector) — Relational + Vector
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=your_pgvector_password
PGVECTOR_DB=whoareryu
DATABASE_URL=postgresql+asyncpg://postgres:your_pgvector_password@pgvector:5432/whoareryu

# Redis (Docker: whoareryu-redis)
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@redis:6379/0

# ── Kakao 로그인 ───────────────────────────────────────────────────
# Kakao Developers → 앱 → REST API 키 (JavaScript 키 넣으면 401). 웹 로그인 client_id로 쓴다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# 모바일 로그인(OIDC id_token 검증용) — 플러터 KakaoSdk.init(nativeAppKey:)와 동일한 값
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key
KAKAO_ISSUER=https://kauth.kakao.com
KAKAO_JWKS_URL=https://kauth.kakao.com/.well-known/jwks.json

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Ollama (로컬 LLM) ──────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434

# ── 소유자 세션 ────────────────────────────────────────────────────
OWNER_EMAIL=your_owner_email
OWNER_SESSION_SECRET=your_owner_session_secret

# ── 테이블 자동 생성 ───────────────────────────────────────────────
AUTO_CREATE_TABLES=false

GEMINI_API_KEY=
GOOGLE_API_KEY=