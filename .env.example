# --- Vercel 단독 테스트 (백엔드 없음) ---
# BACKEND_URL 을 비우면 /api/gourmet/home-browse·daily-pick 은 목 데이터,
# /api/weather·/api/gourmet/chat 은 Vercel 서버에서 직접 처리합니다.
# GEMINI_API_KEY=...
# OPENWEATHER_API_KEY=...
# OPENWEATHER_CITY=Seoul
# STANDALONE_API=true   # BACKEND_URL 이 있어도 프론트 API만 쓰려면 설정

# --- 전체 스택 (Neon DB·실제 맛집 데이터) ---
# BACKEND_URL=http://127.0.0.1:8000
# BACKEND_URL=https://your-api.example.com
