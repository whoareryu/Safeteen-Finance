# FastAPI 백엔드 — Vercel 필수 (Production·Preview·Build 모두 체크)
# 로컬
BACKEND_URL=http://127.0.0.1:8000
# 프로덕션: 공개 HTTPS URL (예: Railway/Render/Fly에 배포한 FastAPI)
# BACKEND_URL=https://your-api.example.com

# 프론트 전용 Gemini (선택) — /api/gemini/chat 만 사용. 맛집 채팅은 /api/gourmet/chat → 백엔드
# GEMINI_API_KEY=your_gemini_api_key

# 날씨·Kakao·LOCALDATA 키는 backend/.env 에만 (OPENWEATHER_API_KEY 등).
